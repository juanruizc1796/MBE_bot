# Proveedor del LLM del chat: "openrouter" (por defecto) o "groq" (respaldo)
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
# Se usa en el chat si LLM_PROVIDER=groq. También lo necesita el análisis de temas del reporte docente.
GROQ_API_KEY=

# Clave para firmar los JWT (HS256). Usar un valor largo y aleatorio.
JWT_SECRET_KEY=

# Opcional: trazas de LangGraph/LangSmith
LANGSMITH_API_KEY=

# Opcional: ruta de la BD de logs (relativa a rag_engine/)
# LOGS_DB_PATH=data/logs/mbe_logs.db
